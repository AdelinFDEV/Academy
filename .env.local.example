# Variables de entorno locales para Supabase
# Copia este archivo, renómbralo a ".env.local" y coloca tus credenciales reales.
# Puedes obtener estos valores en tu panel de Supabase (Settings -> API) o desde Vercel (Environment Variables).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ── Supabase: clave de servicio (SOLO servidor) ──────────────────────────────
# Supabase → Settings → API → service_role secret.
# La usa el webhook de Stripe para cambiar roles ignorando RLS. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ── Stripe ───────────────────────────────────────────────────────────────────
# Stripe → Developers → API keys → Secret key (sk_live_... o sk_test_...)
STRIPE_SECRET_KEY=sk_live_xxx
# Stripe → Developers → Webhooks → (tu endpoint) → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Enlace de pago (Payment Link). OPCIONAL y normalmente sobra: el del código ya
# apunta al precio vigente. Solo tiene sentido definirla para probar otro enlace
# sin desplegar — y si se define con uno viejo, pisa al del código y la web cobra
# el precio antiguo sin dar ningún error. Dejarla vacía es lo correcto.
# STRIPE_PAYMENT_LINK=

# ── Gemini (redacción de noticias con IA) ─────────────────────────────────────
# Google AI Studio → Get API key → Create API key.
# Sin ella, /noticias sigue funcionando pero con el recorte extractivo (sin IA):
# ver resumenExtractivo() en src/lib/resumir.ts.
GEMINI_API_KEY=
# OPCIONAL. Modelo de Gemini a usar. Por defecto gemini-3.5-flash-lite, que es
# el que más cuota gratuita da (15 RPM). OJO: la familia 2.5 entera devuelve 404
# en cuentas nuevas ("no longer available to new users"), así que no la pongas.
GEMINI_MODEL=

# ── Cron y YouTube ─────────────────────────────────────────────────────────────
# Protege /api/cron/diario de llamadas externas. Vercel Cron la envía
# automáticamente como "Authorization: Bearer <CRON_SECRET>" si la defines.
CRON_SECRET=otro-secreto-aleatorio
# OPCIONAL. ID del canal de YouTube (UC...). Si se deja vacío se usa el de
# AdelinBTC, escrito en src/lib/youtube.ts. NO se deduce del @handle en
# producción: YouTube responde 302 vacío a esa página desde centros de datos.
YOUTUBE_CHANNEL_ID=
# MUY RECOMENDABLE. Clave de la YouTube Data API v3. Sin ella, la duración de
# los vídeos se lee raspando youtube.com, que desde un servidor puede fallar
# sin avisar y dejar la home sin vídeos. Con clave basta UNA
# petición para todos y la cuota gratuita (10.000/día) sobra de sobra.
# También la necesitan los objetivos de suscriptores en /admin/objetivos: sin
# ella el cron no puede fotografiar la cifra cada día.
# Google Cloud → APIs y servicios → Habilitar "YouTube Data API v3" → Crear credencial → Clave de API
YOUTUBE_API_KEY=

# ── CoinGecko ────────────────────────────────────────────────────────────────
# IMPRESCINDIBLE EN PRODUCCIÓN. Clave Demo gratuita (coingecko.com/en/api →
# Developer Dashboard → Add New Key). Sin ella, CoinGecko bloquea las IPs
# compartidas de Vercel y la web se queda sin Bitcoin 24h, sin Portfolio Adelin
# y sin mercados, sin dar ningún error. En local es opcional. SIN NEXT_PUBLIC_:
# no debe llegar nunca al navegador. Ver cgFetch() en src/lib/coingecko.ts.
COINGECKO_API_KEY=

# ── Google Analytics 4 (opcional) ────────────────────────────────────────────
# Analytics → Administrar → Flujos de datos → tu flujo web → "ID de medicion".
# Tiene la forma G-XXXXXXXXXX.
#
# Si falta esta variable, el componente <GoogleAnalytics> no pinta nada y el
# sitio funciona igual: es lo normal en local, para no ensuciar las metricas
# reales con las visitas de desarrollo.
#
# La etiqueta ademas SOLO se carga si el visitante acepta las cookies en el
# banner. Ver src/components/GoogleAnalytics.tsx y src/lib/consent.ts.
NEXT_PUBLIC_GA_ID=

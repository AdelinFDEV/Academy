# Variables de entorno locales para Supabase
# Copia este archivo, renómbralo a ".env.local" y coloca tus credenciales reales.
# Puedes obtener estos valores en tu panel de Supabase (Settings -> API) o desde Vercel (Environment Variables).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ── Supabase: clave de servicio (SOLO servidor) ──────────────────────────────
# Supabase → Settings → API → service_role secret.
# La usa el webhook de Stripe para cambiar roles ignorando RLS. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ── Stripe ───────────────────────────────────────────────────────────────────
# Stripe → Developers → API keys → Secret key (sk_live_... o sk_test_...)
STRIPE_SECRET_KEY=sk_live_xxx
# Stripe → Developers → Webhooks → (tu endpoint) → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Enlace de pago (Payment Link). Opcional: si no se define se usa el del código.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/00w3cvgC86CGbKReVTaZi02

# ── Telegram (comunidad Premium) ─────────────────────────────────────────────
# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Username del bot sin @ (te lo confirma @BotFather al crearlo)
TELEGRAM_BOT_USERNAME=TuAcademiaBot
# ID numérico del canal privado (empieza por -100...). Reenvía cualquier
# mensaje del canal a @userinfobot o @getidsbot para obtenerlo.
TELEGRAM_CHANNEL_ID=-1001234567890
# Cadena secreta inventada por ti (letras/números, sin espacios). Telegram la
# reenvía en cada webhook para verificar que la petición viene de ellos.
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio
# Enlace de invitación del canal con "Solicitar aprobación de administradores"
# activado (Telegram → tu canal → Enlaces de invitación → Crear nuevo enlace).
TELEGRAM_CHANNEL_INVITE_LINK=https://t.me/+xxxxxxxxxxxxxxxx
# OPCIONAL. Chat al que llegan los mensajes de soporte que escriben los
# Premium al bot. Si se deja vacío se usa el Telegram del admin (el que tenga
# vinculado en su perfil), que es lo normal. Ponlo solo si quieres que el
# soporte caiga en un grupo con varios moderadores: crea el grupo, mete al bot
# y usa el ID del grupo (empieza por -100...).
TELEGRAM_ADMIN_CHAT_ID=
# Protege /api/cron/telegram-sync de llamadas externas. Vercel Cron la envía
# automáticamente como "Authorization: Bearer <CRON_SECRET>" si la defines.
CRON_SECRET=otro-secreto-aleatorio

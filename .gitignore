# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

.vercel
.env*
# La plantilla sí va al repo: no lleva credenciales reales y sin ella un clon
# nuevo no sabe qué variables hacen falta.
!.env.local.example

# Auditoría de seguridad interna — no publicar (repo público)
INFORME-SEGURIDAD.md

# scripts/anuncio-manual.mjs: caché del aviso pendiente de aprobar y los
# textos sueltos que se le pasan por --texto. Contenido de un envío puntual,
# no algo que viva en el repo.
scripts/.anuncio-manual-cache.json
scripts/anuncio-manual.mensaje*.txt

# scripts sueltos de una sola vez: se crean en la raiz para que resuelvan
# node_modules y se borran al terminar. Si alguno sobrevive, que no acabe
# en un commit (ya paso una vez con .rss.mjs).
.*.mjs

# Copias locales antes de borrar datos (llevan ids de usuarios: nunca al repo)
backups/
